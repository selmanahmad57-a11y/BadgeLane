### BadgeLane — modèle de configuration locale
#
# Copie ce fichier en `.env.local` (git-ignoré) puis renseigne les valeurs :
#     cp .env.local.example .env.local
#
# Toute variable sans valeur par défaut fait échouer le démarrage avec un
# message nommant la variable manquante : aucune valeur n'est devinée en code.
#
# Légende :
#   [OBLIGATOIRE] l'application ne démarre pas sans
#   [FACULTATIF]  laisser vide désactive proprement la fonctionnalité
#   [À DÉCIDER]   dépend de ton marché — je ne l'ai pas choisi à ta place


## ─── Base de données — Neon ──────────────────────────────────────────────────
#
# DEUX connexions, avec deux rôles distincts. Ce n'est pas de la coquetterie :
# le rôle `neondb_owner` livré par défaut avec un projet Neon hérite de
# `neon_superuser`, qui porte l'attribut BYPASSRLS. Cet attribut neutralise
# TOUTES les politiques RLS, `FORCE ROW LEVEL SECURITY` compris. Une application
# connectée avec lui lit les données de toutes les écoles, sans le moindre
# signal d'alerte.
#
# → migrations : rôle propriétaire (droits DDL)
# → application : rôle dédié, sans BYPASSRLS, données uniquement

# Chaîne de connexion du rôle propriétaire.
# Où la trouver : console.neon.tech > ton projet > Connection Details.
# Prends la chaîne « Pooled connection » (elle contient `-pooler`), format :
#   postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# [OBLIGATOIRE]
DATABASE_MIGRATION_URL=

# Nom du rôle applicatif. Créé en SQL par `npm run db:grant` — surtout pas
# depuis la console Neon, qui rend automatiquement les nouveaux rôles membres
# de `neon_superuser` et réintroduirait le problème.
# [OBLIGATOIRE]
DATABASE_APP_ROLE_NAME=badgelane_app

# Mot de passe de ce rôle. À générer, pas à inventer :
#   openssl rand -base64 32
# [OBLIGATOIRE]
DATABASE_APP_ROLE_PASSWORD=

# Chaîne de connexion du rôle applicatif — c'est elle que l'application utilise.
# `npm run db:grant` l'affiche une fois le rôle créé : copie-la ici.
# [OBLIGATOIRE]
DATABASE_URL=

# Taille max du pool de connexions. Vide = valeur par défaut du driver.
# À ne renseigner que si Neon signale une saturation.
# [FACULTATIF]
DATABASE_POOL_MAX=


## ─── Authentification — Clerk ────────────────────────────────────────────────
#
# Où les trouver : dashboard.clerk.com > ton application > API Keys.
#
# ⚠️ Active « Organizations » dans Configure > Organizations : chaque école est
#    une Organization Clerk. Sans ça, la création d'école ne fonctionnera pas.
#
# [OBLIGATOIRE]
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# [OBLIGATOIRE]
CLERK_SECRET_KEY=

# Secret de signature des webhooks Clerk (dashboard.clerk.com > Webhooks).
# Inutile tant que l'app tourne en local : la synchronisation se fait à la
# connexion. À renseigner une fois déployé sur une URL publique.
# [FACULTATIF]
CLERK_WEBHOOK_SIGNING_SECRET=


## ─── Application ─────────────────────────────────────────────────────────────
#
# URL publique de l'app. En local : http://localhost:3000
# En production : https://badgelane.com
# [OBLIGATOIRE]
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Langues activées, séparées par des virgules.
# Ajouter une langue = ajouter son code ici + déposer `messages/<code>.json`.
# Aucun fichier TypeScript n'est à modifier.
# [OBLIGATOIRE]
NEXT_PUBLIC_SUPPORTED_LOCALES=en,es

# Langue de repli quand celle du visiteur n'est pas supportée.
# Doit figurer dans NEXT_PUBLIC_SUPPORTED_LOCALES.
# [OBLIGATOIRE]
NEXT_PUBLIC_DEFAULT_LOCALE=en


## ─── Valeurs par défaut d'une nouvelle école ─────────────────────────────────
#
# Appliquées à la création d'une école, avant que son admin ne les change dans
# les réglages. Elles dépendent du marché que tu vises — je les ai laissées
# vides plutôt que de les inventer.
#
# Exemples pour un lancement aux États-Unis :
#   DEFAULT_ORGANIZATION_TIMEZONE=America/New_York
#   DEFAULT_ORGANIZATION_CURRENCY=USD
#   DEFAULT_ORGANIZATION_COUNTRY=US
#
# Fuseau IANA — https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# [À DÉCIDER]
DEFAULT_ORGANIZATION_TIMEZONE=

# Devise ISO 4217, 3 lettres majuscules (USD, EUR, CAD…)
# [À DÉCIDER]
DEFAULT_ORGANIZATION_CURRENCY=

# Pays ISO 3166-1 alpha-2, 2 lettres majuscules (US, FR, CA…)
# Conditionne le régime de conformité applicable (COPPA vs RGPD).
# [À DÉCIDER]
DEFAULT_ORGANIZATION_COUNTRY=


## ─── Facturation — Stripe (facultatif tant que non branché) ──────────────────
#
# Sans ces clés, l'application démarre et fonctionne : l'écran Facturation
# affiche simplement « non disponible ». Une école qui n'a pas encore connecté
# son compte doit pouvoir utiliser tout le reste du produit.
#
# Où les trouver : dashboard.stripe.com > Developers > API keys (mode test).
#
# ⚠️ Active **Connect** dans le tableau de bord Stripe, comme on avait activé
#    Organizations chez Clerk. Sans cela, la création d'un compte connecté
#    échouera.
#
# [FACULTATIF]
STRIPE_SECRET_KEY=

# Secret de signature du webhook. Fourni par `stripe listen` en local, ou par
# le tableau de bord une fois l'endpoint déclaré. Nécessaire au Temps 2.
# [FACULTATIF]
STRIPE_WEBHOOK_SECRET=


## ─── Observabilité — Sentry (entièrement facultatif) ─────────────────────────
#
# Tout est vide par défaut : l'application démarre et fonctionne sans compte
# Sentry. Rien à commenter, rien à supprimer.
#
# Où les trouver : sentry.io > Settings > Projects > ton projet > Client Keys.
#
# DSN serveur (erreurs de rendu, routes API, proxy)
# [FACULTATIF]
SENTRY_DSN=
# DSN navigateur — en général le même que ci-dessus
# [FACULTATIF]
NEXT_PUBLIC_SENTRY_DSN=

# Taux d'échantillonnage entre 0 et 1. Vides = fonctionnalité désactivée.
# À régler une fois en production, en fonction du volume réel.
# [FACULTATIF]
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=

# Upload des source maps au build. Les trois ensemble, ou aucune :
# une seule valeur manquante désactive l'upload sans faire échouer le build.
# Token : sentry.io > Settings > Auth Tokens (scope `project:releases`).
# [FACULTATIF]
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
